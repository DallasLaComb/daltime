# Copy to .env.mobile.dev / .env.mobile.qa / .env.mobile.main (git-ignored), or generate with:
#   aws sso login --sso-session daltime
#   npm run mobile:env:pull:dev        (also :qa, :main)
#
# These are the same five values cd.yml injects into the web bundle. They are not secret, but the
# real files stay git-ignored. CI sets them as environment variables instead.
#
# Where they come from (region us-east-1, profile daltime-dev | daltime-qa | daltime-prod):
#   API_BASE_URL          backend stack (daltime-backend-dev | -qa | -prod)   output ApiEndpoint
#   COGNITO_USER_POOL_ID  foundation stack (daltime-foundation-dev | -qa | -main)  output UserPoolId
#   COGNITO_CLIENT_ID     foundation stack   output UserPoolClientId
#   COGNITO_REGION        foundation stack   output CognitoRegion
#   COGNITO_DOMAIN        foundation stack   output CognitoDomain
API_BASE_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_REGION=us-east-1
COGNITO_DOMAIN=daltime-xxx.auth.us-east-1.amazoncognito.com
